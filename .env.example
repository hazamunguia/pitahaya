# Copia este archivo a .env.local y llena los valores. Nunca subas .env.local a GitHub.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Project Settings → API Keys)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Solo en el servidor (Vercel y .env.local). NUNCA con prefijo NEXT_PUBLIC_
SUPABASE_SECRET_KEY=

# Avisos push: corre `npm run vapid` en tu compu y pega las 3 líneas en Vercel (no las compartas en chats).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu-correo@ejemplo.com
