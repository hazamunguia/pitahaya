# Copia este archivo a .env.local y llena los valores. Nunca subas .env.local a GitHub.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Project Settings → API Keys)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Solo en el servidor (Vercel y .env.local). NUNCA con prefijo NEXT_PUBLIC_
SUPABASE_SECRET_KEY=

# Avisos push (se generan en un paso posterior)
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
